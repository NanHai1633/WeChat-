<view class="container" wx:if="{{detail}}">
  <view class="card">
    <view class="row">
      <view class="title-large grow">{{detail.username}}</view>
      <view class="tag {{statusCls}}">{{statusText}}</view>
    </view>
    <view class="muted">{{detail.title}}</view>
    <view class="grade-summary">
      <view class="grade-summary-item" wx:if="{{detail.autoScore !== null}}">自动判分 <text class="grade-num">{{detail.autoScore}}</text></view>
      <view class="grade-summary-item" wx:if="{{detail.totalScore !== null}}">总分 <text class="grade-num">{{detail.totalScore}}</text></view>
      <view class="grade-summary-item">满分 <text class="grade-num">{{detail.maxScore}}</text></view>
    </view>
    <view class="muted mt" wx:if="{{remaining > 0}}">判完这份后，还有 {{remaining}} 份待判</view>
    <view class="notice mt" wx:if="{{inProgress}}">学生还在作答，交卷后才能判卷</view>
  </view>

  <view wx:for="{{essays}}" wx:key="questionId" class="card">
    <view class="row">
      <view style="font-weight: 700;">第 {{item.no}} 题 · 大题（{{item.maxScore}} 分）</view>
      <view class="tag {{item.verdictCls}}" wx:if="{{!inProgress}}">{{item.verdictText}}</view>
    </view>
    <view class="question-text">{{item.content}}</view>
    <view class="gallery" wx:if="{{item.imageUrls.length > 0}}">
      <image wx:for="{{item.imageUrls}}" wx:for-item="url" wx:key="*this" class="thumb" src="{{url}}" mode="aspectFill"
             data-urls="{{item.imageUrls}}" data-current="{{url}}" bindtap="onPreview"></image>
    </view>
    <view class="answer-block answer-student">
      <view class="muted">学生的结果</view>
      <view class="pre">{{item.studentText}}</view>
      <view class="gallery" wx:if="{{item.photoUrls.length > 0}}">
        <image wx:for="{{item.photoUrls}}" wx:for-item="url" wx:key="*this" class="thumb" src="{{url}}" mode="aspectFill"
               data-urls="{{item.photoUrls}}" data-current="{{url}}" bindtap="onPreview"></image>
      </view>
    </view>
    <view class="answer-block" wx:if="{{item.correctAnswer}}">
      <view class="muted">参考答案</view>
      <view class="pre">{{item.correctAnswer}}</view>
    </view>
    <block wx:if="{{!inProgress}}">
      <view class="label">得分（0 - {{item.maxScore}}）</view>
      <input class="input" type="digit" value="{{item.scoreInput}}" data-i="{{index}}" bindinput="onScore" />
      <view class="choices">
        <view class="choice" data-i="{{index}}" data-value="0" bindtap="onQuick">0 分</view>
        <view class="choice" data-i="{{index}}" data-value="{{item.halfScore}}" bindtap="onQuick">一半</view>
        <view class="choice" data-i="{{index}}" data-value="{{item.maxScore}}" bindtap="onQuick">满分</view>
      </view>
      <view class="label">评语（选填）</view>
      <input class="input" value="{{item.commentInput}}" maxlength="1000" data-i="{{index}}" bindinput="onComment" />
    </block>
  </view>

  <view class="card" wx:if="{{others.length > 0}}">
    <view class="row" bindtap="onToggleAuto">
      <view class="text-blue" style="font-weight: 600;">自动判分的题目（{{others.length}} 题）</view>
      <view class="muted">{{showAuto ? '收起' : '展开'}}</view>
    </view>
    <block wx:if="{{showAuto}}">
      <view wx:for="{{others}}" wx:key="questionId" class="auto-item">
        <view class="row">
          <view class="muted">第 {{item.no}} 题 · {{item.typeText}}</view>
          <view class="tag {{item.verdictCls}}" wx:if="{{!inProgress}}">{{item.verdictText}}</view>
        </view>
        <view class="pre mt">{{item.content}}</view>
        <view class="gallery" wx:if="{{item.imageUrls.length > 0}}">
          <image wx:for="{{item.imageUrls}}" wx:for-item="url" wx:key="*this" class="thumb" src="{{url}}" mode="aspectFill"
                 data-urls="{{item.imageUrls}}" data-current="{{url}}" bindtap="onPreview"></image>
        </view>
        <view class="muted pre mt" wx:if="{{item.optionsText}}">{{item.optionsText}}</view>
        <view class="muted pre mt">学生答案：{{item.studentText}}</view>
        <view class="muted pre">正确答案：{{item.correctText}}</view>
        <view class="muted" wx:if="{{!inProgress}}">得分 {{item.score}} / {{item.maxScore}}</view>
      </view>
    </block>
  </view>

  <view class="bottom-bar" wx:if="{{!inProgress && essays.length > 0}}">
    <button class="btn btn-plain" bindtap="onSave">先保存</button>
    <button class="btn" bindtap="onFinish">{{finishText}}</button>
  </view>
</view>
