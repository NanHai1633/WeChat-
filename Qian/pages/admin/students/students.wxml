<view class="container">
  <view class="page-title" style="margin-bottom: 24rpx;">学生（{{total}}）</view>

  <view class="card">
    <view class="row" bindtap="onToggleCreate">
      <view class="text-blue" style="font-weight: 600;">+ 注册学生</view>
      <view class="muted">{{showCreate ? '收起' : '展开'}}</view>
    </view>
    <block wx:if="{{showCreate}}">
      <view class="label">账号</view>
      <input class="input" value="{{newName}}" placeholder="2-32 位，不含空格" bindinput="onNewName" />
      <view class="label">密码</view>
      <input class="input" value="{{newPassword}}" password placeholder="6-64 位字母、数字或符号" bindinput="onNewPassword" />
      <button class="btn" bindtap="onCreate">注册</button>
    </block>
  </view>

  <input class="input" style="background: #fff; margin: 0 0 22rpx;" value="{{keyword}}" placeholder="搜索账号"
         confirm-type="search" bindinput="onKeyword" bindconfirm="onSearch" />

  <view wx:for="{{students}}" wx:key="id" class="card">
    <view class="row" data-id="{{item.id}}" data-name="{{item.username}}" bindtap="onOpen">
      <view class="title grow">{{item.username}}</view>
      <view class="text-blue muted">做题情况 ›</view>
    </view>
    <view class="muted">注册于 {{item.createdAt}}</view>
    <view class="card-tools">
      <text class="link" data-id="{{item.id}}" data-name="{{item.username}}" bindtap="onReset">重置密码</text>
      <text class="link link-red" data-id="{{item.id}}" data-name="{{item.username}}" bindtap="onDelete">删除</text>
    </view>
  </view>
  <view class="empty" wx:if="{{loaded && students.length === 0}}">没有学生账号</view>

  <view class="tabbar">
    <view class="tabbar-item" data-url="/pages/admin/home/home" bindtap="onTab">工作台</view>
    <view class="tabbar-item" data-url="/pages/admin/papers/papers" bindtap="onTab">试卷</view>
    <view class="tabbar-item tabbar-active">学生</view>
  </view>
</view>
