<view class="container">
  <view class="card">
    <view class="label">原密码</view>
    <input class="input" password value="{{oldPassword}}" bindinput="onOld" />
    <view class="label">新密码（6-64 位字母、数字或符号）</view>
    <input class="input" password value="{{newPassword}}" bindinput="onNew" />
    <button class="btn" bindtap="onSubmit">确认修改</button>
  </view>
</view>
