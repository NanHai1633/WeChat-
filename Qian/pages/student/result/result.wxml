<block wx:if="{{result}}">
  <view class="container" wx:if="{{result.status === 'GRADED'}}">
    <view class="hero hero-card">
      <view class="hero-sub">{{result.title}}</view>
      <view class="hero-score">{{result.totalScore}}</view>
      <view class="hero-sub">满分 {{result.maxScore}} 分</view>
    </view>
    <view class="stats">
      <view class="stat"><text class="stat-num text-green">{{rightCount}}</text>正确</view>
      <view class="stat"><text class="stat-num text-orange">{{partialCount}}</text>部分正确</view>
      <view class="stat"><text class="stat-num text-red">{{wrongCount}}</text>错误</view>
    </view>
    <view class="tabs">
      <view class="tab {{onlyWrong ? '' : 'tab-active'}}" data-wrong="{{false}}" bindtap="onFilter">全部（{{allItems.length}}）</view>
      <view class="tab {{onlyWrong ? 'tab-active' : ''}}" data-wrong="{{true}}" bindtap="onFilter">错题（{{wrongItems.length}}）</view>
    </view>
    <view wx:for="{{items}}" wx:key="questionId" class="card">
      <view class="row">
        <view class="muted">第 {{item.no}} 题 · {{item.typeText}}</view>
        <view class="tag {{item.verdictCls}}">{{item.verdictText}}</view>
      </view>
      <view class="question-text">{{item.content}}</view>
      <view class="gallery" wx:if="{{item.imageUrls.length > 0}}">
        <image wx:for="{{item.imageUrls}}" wx:for-item="url" wx:key="*this" class="thumb" src="{{url}}" mode="aspectFill"
               data-urls="{{item.imageUrls}}" data-current="{{url}}" bindtap="onPreview"></image>
      </view>
      <view class="muted pre mt" wx:if="{{item.optionsText}}">{{item.optionsText}}</view>
      <view class="answer-block">
        <view class="muted">我的答案</view>
        <view class="pre">{{item.answerText}}</view>
        <view class="gallery" wx:if="{{item.photoUrls.length > 0}}">
          <image wx:for="{{item.photoUrls}}" wx:for-item="url" wx:key="*this" class="thumb" src="{{url}}" mode="aspectFill"
                 data-urls="{{item.photoUrls}}" data-current="{{url}}" bindtap="onPreview"></image>
        </view>
      </view>
      <view class="row mt">
        <view class="muted">得分</view>
        <view><text class="grade-num">{{item.score}}</text> / {{item.maxScore}}</view>
      </view>
      <view class="notice mt pre" wx:if="{{item.comment}}">老师评语：{{item.comment}}</view>
    </view>
    <view class="empty" wx:if="{{items.length === 0}}">没有错题，全部答对了</view>
  </view>

  <view class="container" wx:else>
    <view class="card center">
      <view class="wait-icon">✓</view>
      <view class="title-large">已交卷</view>
      <view class="muted mt">{{result.title}}</view>
      <view class="muted">老师判完大题后，这里会显示成绩</view>
      <button class="btn btn-plain" bindtap="onReview">查看我的作答</button>
    </view>
  </view>
</block>
