<view class="container">
  <view class="login-logo">题</view>
  <view class="login-title">做题系统</view>
  <view class="card">
    <view class="label" style="margin-top: 0;">账号</view>
    <input class="input" value="{{username}}" placeholder="请输入账号" bindinput="onUsername" />
    <view class="label">密码</view>
    <input class="input" value="{{password}}" password placeholder="请输入密码" bindinput="onPassword" />
    <button class="btn {{loading ? 'btn-disabled' : ''}}" disabled="{{loading}}" bindtap="onLogin">登录</button>
  </view>
</view>
